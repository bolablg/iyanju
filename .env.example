# Public pages need no environment variables. Keep accounts disabled until reviewed.
IYANJU_ENABLE_ACCOUNTS=false
# Use the iyanju Clerk app. Existing services adopt it separately.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Exact origins, comma-separated. Development example:
IYANJU_AUTHORIZED_PARTIES=http://127.0.0.1:3000
# Production activation additionally requires the adoption/privacy review:
IYANJU_AUTH_REVIEWED=false
